# carch deployment secrets
# Copy this file to secrets.env, fill in the values, then run deploy-carch.sh.
# The script will shred this file immediately after sourcing it.

# =============================================================================
# REQUIRED
# =============================================================================

# Target disk — use lsblk to confirm the device path before running.
# WARNING: everything on this disk will be destroyed.
DISK="/dev/nvme0n1"

# Hostname for the new machine.
HOSTNAME="cartorio-ws01"

# Primary user account.
USER_NAME="usuario-cartorio"
USER_PASS="change-me-on-first-login"

# Root password. Both this and USER_PASS expire on first login (chage -d 0).
ROOT_PASS="change-me-on-first-login"

# LUKS passphrase for full-disk encryption. Choose something strong — this
# protects the entire disk if the machine is lost or stolen.
LUKS_PASS="strong-luks-passphrase"

# Self-hosted Headscale coordination server for Tailscale VPN.
# After first boot run: sudo /usr/local/sbin/tailscale-join.sh
HEADSCALE_URL="https://hs.your-domain.com"
HEADSCALE_AUTHKEY="hskey-xxxxxxxxxxxxxxxxxxx"

# =============================================================================
# OPTIONAL
# =============================================================================

# WiFi credentials — used in two places:
#   1. To connect the live ISO to the network before installation begins.
#   2. To pre-configure a NetworkManager profile in the installed system.
# Leave both empty if the machine will use Ethernet.
WIFI_SSID=""
WIFI_PASS=""

# Git repository with dotfiles to deploy into the user's home directory after
# install. The repo is cloned shallow and copied without its .git directory.
# Leave empty to skip this step.
DOTFILES_REPO=""
